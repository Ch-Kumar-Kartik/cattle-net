# Start with an allow-list for the production backend image.
*
!Dockerfile
!.dockerignore
!README.md
!pyproject.toml
!uv.lock
!src/
!src/cattle_net/
!src/cattle_net/**
!artifacts/
!artifacts/cattle_resnet18_v1.pth
!artifacts/classes.json
!alembic/
!alembic/**
!alembic.ini

# Never send local environments, secrets, databases, or frontend build files.
.venv/
.git/
.env
.env.*
**/.env
**/.env.*
.pgpass
*.pem
*.key
*.p12
*.pfx
service-account*.json
*service-account*.json
cattle-net.db
*.db
*.db-*
*.db-journal
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.bak
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/.turbo/
frontend/.cache/
node_modules/
.next/
**/.vercel/

# Exclude datasets, notebooks, tests, caches, and generated files.
data/
datasets/
training_output/
runs/
wandb/
mlruns/
lightning_logs/
notebooks/
*.ipynb
tests/
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/
