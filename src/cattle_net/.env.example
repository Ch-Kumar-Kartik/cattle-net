# Select the inference device. The safe default is cpu.
MODEL_DEVICE=cpu

# Local development uses SQLite by default. Production should use async PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database_name

# Comma-separated browser origins. Do not use * because credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication secret. Use a random value of at least 32 bytes.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
